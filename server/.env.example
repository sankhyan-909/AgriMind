PORT=5000

# MongoDB Atlas / MongoDB connection
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/agrimind?retryWrites=true&w=majority

# Use a long random value in real deployments
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend origin
CLIENT_URL=http://localhost:5173

# Optional Government of India data.gov.in API key
DATA_GOV_IN_API_KEY=
